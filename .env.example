# Without Supabase URL and keys, the app uses the in-memory mock store (lib/mock-db.ts).
# Set these when you want to override defaults or enable optional services.

# Admin dummy login (default: admin@churchpay.co.uk / admin)
ADMIN_EMAIL=admin@churchpay.co.uk
ADMIN_PASSWORD=admin
ADMIN_ROLE=super_admin
SESSION_SECRET=use-a-long-random-string-in-production

# Supabase (optional: enables Postgres-backed data and RLS)
NEXT_PUBLIC_SUPABASE_URL=https://gjxswrazgoedjkyfhbcn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_fNdXyDf18S4HhKHGvYX3ow_YzBMkbvg
SUPABASE_SERVICE_ROLE_KEY=

# In-memory mock (optional). Set to false when using Supabase so mock data cannot load if env is wrong.
ALLOW_IN_MEMORY_MOCK=true

# Stripe (legacy only - Mooov is the primary payment rail)
STRIPE_SECRET_KEY=sk_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (optional, welcome email, contact form)
# Domain: churchpayment.com (verified via Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=ChurchPay <noreply@churchpayment.com>
RESEND_FROM_EMAIL=ChurchPay <noreply@churchpayment.com>
EMAIL_LOGO_URL=https://fgtqpeswnakznsvibfvp.supabase.co/storage/v1/object/public/email-assets/churchpay-email-logo.png
CONTACT_EMAIL=ag@experrt.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI (optional: richer church one-pager drafts in admin)
OPENAI_API_KEY=

# Cron (optional: protect /api/cron/* routes)
CRON_SECRET=

# Platform owner bootstrap (scripts/bootstrap-platform-owner.mjs only)
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
PLATFORM_OWNER_NAME=

# Mooov Connect staging (server-only; set secrets in Vercel env, never commit values)
MOOOV_PLATFORM_SLUG=churchpay
MOOOV_PLATFORM_ID=plat_churchpay
MOOOV_API_BASE=https://staging.api.mooov.money
MOOOV_CONNECT_BASE=https://staging.connect.mooov.money
MOOOV_CONNECT_MODE=test
MOOOV_REDIRECT_URI=https://www.churchpay.co.uk/oauth/mooov/callback
# Pre-seeded staging merchant for day-one smoke tests. Mooov uses this value
# as the merchant id sent in the Mooov-Merchant header.
MOOOV_DEMO_CHURCH_ID=merch_churchpay_demo
MOOOV_DEMO_MERCHANT_ID=
# Sensitive secrets.
MOOOV_PLATFORM_API_KEY_ID=
MOOOV_PLATFORM_API_KEY_SECRET=
MOOOV_PLATFORM_WEBHOOK_SIGNING_SECRET=

# Belt-and-braces fallback for SCA 3DS resume. Mooov publishes the
# Stripe publishable key inline on the requires_action envelope, but
# may emit "" on rare gateway boot events. Set this to Mooov's platform
# pk_test_* (staging) or pk_live_* (prod) so loadStripe() never blocks a
# 3DS challenge. Optional — leave unset and we'll just 500 on the rare
# elision case.
NEXT_PUBLIC_MOOOV_STRIPE_PUBLISHABLE_KEY=

# Giving monthly subscription feature gate.
# Mooov's saved-charge subscription contract (Slice 3) ships to staging
# Wed 3 Jun 2026 and prod Fri 5 Jun 2026. Until LP is talking to a Mooov
# environment that has shipped Slice 3, leave this UNSET (or set to
# "false") so /api/giving/pay with mode="subscription" returns 503 and the
# daily charge cron is a no-op. Flip to "true" on or after the relevant
# cutover.
CHURCHPAY_GIVING_SUBSCRIPTION_ENABLED=false
