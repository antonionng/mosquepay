# No database required. All data uses in-memory mock store (lib/mock-db.ts).
# Set these when you want to override defaults or enable optional services.

# Admin dummy login (default: admin@covenantlodge.org.uk / admin)
ADMIN_EMAIL=admin@covenantlodge.org.uk
ADMIN_PASSWORD=admin
SESSION_SECRET=use-a-long-random-string-in-production

# Stripe (optional – for real event payments)
STRIPE_SECRET_KEY=sk_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (optional – welcome email, contact form)
RESEND_API_KEY=re_...
EMAIL_FROM=Covenant Lodge <noreply@covenantlodge.org.uk>
CONTACT_EMAIL=secretary@covenantlodge.org.uk

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When you plug in Supabase later, add:
# NEXT_PUBLIC_SUPABASE_URL=...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
