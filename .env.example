# Without Supabase URL and keys, the app uses the in-memory mock store (lib/mock-db.ts).
# Set these when you want to override defaults or enable optional services.

# Admin dummy login (default: admin@covenantlodge.org.uk / admin)
ADMIN_EMAIL=admin@covenantlodge.org.uk
ADMIN_PASSWORD=admin
ADMIN_ROLE=super_admin
SESSION_SECRET=use-a-long-random-string-in-production

# Supabase (optional: enables Postgres-backed data and RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# In-memory mock (optional). Set to false when using Supabase so mock data cannot load if env is wrong.
ALLOW_IN_MEMORY_MOCK=true

# Stripe (optional – for real event payments)
STRIPE_SECRET_KEY=sk_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (optional, welcome email, contact form)
RESEND_API_KEY=re_...
EMAIL_FROM=LodgePay <noreply@lodgepayments.co.uk>
RESEND_FROM_EMAIL=LodgePay <noreply@lodgepayments.co.uk>
EMAIL_LOGO_URL=https://your-public-logo-url.example.com/lodgepay-email-logo.png
CONTACT_EMAIL=ag@experrt.com

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI (optional: richer lodge one-pager drafts in admin)
OPENAI_API_KEY=

# Cron (optional: protect /api/cron/* routes)
CRON_SECRET=

# Platform owner bootstrap (scripts/bootstrap-platform-owner.mjs only)
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_PASSWORD=
PLATFORM_OWNER_NAME=

# Mooov payments gateway (Preview + Development scope on Vercel; Sensitive=Yes for the three secrets).
# See docs/integrations-evidence.md and the dev quickstart for the canonical list.
MOOOV_BASE_URL=https://gateway-staging-vtpxtwykca-uc.a.run.app
MOOOV_PLATFORM_MERCHANT_ID=merch_lpay_platform
MOOOV_LODGE_PILOT_MERCHANT_ID=merch_lpay_lodge_pilot
# format: mk_live_<hex16>
MOOOV_PLATFORM_KEY_ID=
# 48 lowercase hex chars; HMAC secret used as a UTF-8 string (NOT hex-decoded)
MOOOV_PLATFORM_KEY_SECRET=
# 48 lowercase hex chars; outbound-webhook signing secret
MOOOV_PLATFORM_WEBHOOK_SECRET=
